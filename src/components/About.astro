---
import Eyebrow from "./Eyebrow.astro";
import Placeholder from "./Placeholder.astro";

const creds = [
  "Titulación oficial — completar",
  "Especialista en readaptación — completar",
  "+X años de experiencia — completar",
];
---

<section class="bg-bg2 py-20 nav:py-[110px]" id="sobre-mi">
  <div
    class="container-x grid items-center gap-11 nav:grid-cols-[0.9fr_1.1fr] nav:gap-16"
  >
    <div class="reveal from-left">
      <Placeholder label="foto: retrato de Carmen" class="aspect-[4/5]" />
    </div>
    <div class="reveal from-right grid gap-[18px]">
      <Eyebrow>Sobre mí</Eyebrow>
      <h2 class="display text-[clamp(34px,4.6vw,54px)]">Soy Carmen</h2>
      <p class="text-pretty text-[17px] text-muted">
        Entrenadora personal especializada en readaptación deportiva. Llevo años
        ayudando a personas a recuperarse de sus lesiones y a entrenar con
        cabeza: deportistas que quieren volver a competir, gente que empieza de
        cero y personas mayores que quieren moverse mejor.
      </p>
      <p class="text-pretty text-[17px] text-muted">
        Creo en el trabajo bien hecho, progresivo y sin atajos. Mi objetivo es
        que entiendas tu cuerpo, pierdas el miedo a moverte y consigas resultados
        que se mantengan.
      </p>
      <div class="mt-2.5 flex flex-wrap gap-2.5">
        {creds.map((cred) => (
          <span
            class="inline-flex items-center gap-2 rounded-full border border-accent/35 bg-accent/15 px-4 py-2 text-[14px] font-semibold text-text"
          >
            <span class="size-1.5 flex-none rounded-full bg-accent"></span>
            {cred}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
