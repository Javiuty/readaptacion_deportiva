---
import Eyebrow from "./Eyebrow.astro";
import Placeholder from "./Placeholder.astro";

const creds = [
  "Titulación oficial — completar",
  "Especialista en readaptación — completar",
  "+X años de experiencia — completar",
];
---

<section class="bg-bg2 py-20 nav:py-[110px]" id="sobre-mi">
  <div
    class="container-x grid items-center gap-11 nav:grid-cols-[0.9fr_1.1fr] nav:gap-16"
  >
    <div class="reveal from-left">
      <Placeholder label="foto: retrato de Carmen" class="aspect-[4/5]" />
    </div>
    <div class="reveal from-right grid gap-[18px]">
      <Eyebrow>Sobre mí</Eyebrow>
      <h2 class="display text-[clamp(34px,4.6vw,54px)]">Soy Carmen</h2>
      <p class="text-pretty text-[17px] text-muted">
        Entrenadora personal especializada en readaptación deportiva de
        lesiones. A lo largo de mi vida he practicado deportes como gimnasia
        rítmica, baile, natación, yoga, pilates, entrenamiento de fuerza y
        crosstraining.
      </p>
      <p class="text-pretty text-[17px] text-muted">
        Creo en el trabajo de la fuerza como uno de los indicadores principales
        de nuestro estado de salud.
      </p>
      <p class="text-pretty text-[17px] text-muted">
        Cada cuerpo es diferente, con unos patrones y compensaciones distintas:
        mi objetivo es que entiendas cómo funciona el tuyo y que aprendas a
        moverte, pero a moverte bien, con calidad y así no tengas miedo a
        lesionarte. Adaptarte el ejercicio para que lo incluyas fácilmente en tu
        rutina. Los resultados llegan con la constancia y el buen trabajo.
      </p>
      <div class="mt-2.5 flex flex-wrap gap-2.5">
        {
          creds.map((cred) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-accent/35 bg-accent/15 px-4 py-2 text-[14px] font-semibold text-text">
              <span class="size-1.5 flex-none rounded-full bg-accent" />
              {cred}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
