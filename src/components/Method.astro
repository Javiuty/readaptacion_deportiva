---
import SectionHead from "./SectionHead.astro";

const steps = [
  {
    num: "01",
    title: "Valoración inicial",
    text: "Conocemos tu historia, tu lesión y objetivos en el deporte. Analizamos tu postura y evaluamos tu movilidad y fuerza como punto de inicio.",
  },
  {
    num: "02",
    title: "Programación deportiva",
    text: "Elaboramos tu plan personalizado para ponerlo en práctica. En caso de trabajar a distancia, lo adaptamos a tus circunstancias (horario, instalaciones, material disponible, etc.).",
  },
  {
    num: "03",
    title: "Entrenamiento y seguimiento",
    text: "Presencial u online contarás conmigo en tu día a día. Seguiremos tu plan a medida y lo reajustaremos en cualquier momento que lo necesites.",
  },
  {
    num: "04",
    title: "Logro de objetivos",
    text: "Vuelta al deporte en caso de lesión o meta alcanzada si tenemos objetivos claros. Contarás con la base y herramientas para mantenerla a largo plazo.",
  },
];
---

<section class="py-20 nav:py-[110px]" id="metodo">
  <div class="container-x">
    <SectionHead
      eyebrow="Cómo trabajo"
      title="Un proceso claro, medible y adaptado a tu punto de partida."
      text="**Añadir subtexto**"
    />
    <div
      class="reveal-group grid grid-cols-1 gap-5 xs:grid-cols-2 nav:grid-cols-4"
    >
      {
        steps.map((step) => (
          <article class="reveal relative grid content-start gap-3 rounded-card border border-line bg-surface px-[26px] pt-[30px] pb-7">
            <span class="font-display text-[42px] leading-none text-transparent [font-stretch:125%] [-webkit-text-stroke:1.5px_var(--color-accent2)]">
              {step.num}
            </span>
            <h3 class="text-[19px]">{step.title}</h3>
            <p class="text-pretty text-[15px] text-muted">{step.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
