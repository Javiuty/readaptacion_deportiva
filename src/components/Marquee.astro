---
const words = [
  { text: "Fuerza", outline: false },
  { text: "Readaptación", outline: true },
  { text: "Movilidad", outline: false },
  { text: "Confianza", outline: true },
  { text: "Constancia", outline: false },
  { text: "Salud", outline: true },
];
---

<div class="group select-none overflow-hidden border-y border-line bg-bg2 py-5" aria-hidden="true">
  <div
    class="flex w-max motion-safe:animate-marquee group-hover:[animation-play-state:paused]"
  >
    {[0, 1].map(() => (
      <div class="flex items-center gap-[52px] whitespace-nowrap pr-[52px]">
        {words.map((word) => (
          <>
            <span
              class:list={[
                "font-display text-[26px] font-black uppercase tracking-[0.04em] [font-stretch:125%]",
                word.outline ? "text-outline" : "text-muted",
              ]}
            >
              {word.text}
            </span>
            <span class="size-[9px] flex-none rotate-45 rounded-[2px] bg-accent"></span>
          </>
        ))}
      </div>
    ))}
  </div>
</div>
