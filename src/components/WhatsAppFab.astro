---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { WHATSAPP_URL } from "../consts";
---

<a
  class="fixed bottom-[26px] right-[26px] z-[90] grid size-[58px] place-items-center rounded-full bg-wa text-on-wa shadow-[0_12px_32px_oklch(0_0_0/0.28)] transition-transform duration-150 hover:scale-[1.08] motion-safe:animate-fab-pulse"
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp"
>
  <WhatsAppIcon size={26} />
</a>
