---
import SectionHead from "./SectionHead.astro";

const services = [
  {
    num: "01",
    title: "Valoración inicial",
    text: "En este primer paso, haremos un estudio biomecánico y encontraremos los puntos más débiles y compensaciones para determinar los principales objetivos.",
    items: [
      "Estudio biomecánico",
      "Detección de compensaciones",
      "Objetivos personalizados",
    ],
  },
  {
    num: "02",
    title: "Readaptación de lesiones",
    text: "Es el paso entre la fisioterapia y la vuelta al deporte o a la vida activa. Adaptación de ejercicios y cargas para que la zona dañada recupere su capacidad y además, gane más fuerza previniendo futuras recaídas.",
    items: ["Tendinopatías", "Roturas", "Esguinces", "Bursitis"],
  },
  {
    num: "03",
    title: "Entrenamiento personal",
    text: "Sesiones de 1h adaptada exclusivamente a tus objetivos. Seguiremos una planificación elaborada tras la valoración inicial para ir construyendo mejoría de manera progresiva y con sentido.",
    items: [
      "Sesiones de 1h",
      "Plan personalizado",
      "Mejora progresiva",
    ],
  },
  {
    num: "04",
    title: "Programación online",
    text: "Plan de entrenamiento de 3-5 días. Dispondrás de una app donde encontrarás el contenido de tus entrenamientos de manera visual para que sea más fácil e intuitivo (calendario, fotos, vídeos). También podrás guardar tus resultados y así registrar tu evolución.",
    items: [
      "App con fotos y vídeos",
      "Plan de 3-5 días",
      "Registro de tu evolución",
    ],
  },
];
---

<section class="bg-bg2 py-20 nav:py-[110px]" id="servicios">
  <div class="container-x">
    <SectionHead
      eyebrow="Servicios"
      title="Entrena con sentido: valoración, programación y objetivos claros"
      text="Cada persona llega con una historia distinta: una lesión, un objetivo, una etapa. El trabajo siempre empieza por ti."
    />
    <div class="reveal-group grid gap-6 nav:grid-cols-3">
      {
        services.map((service) => (
          <article class="reveal grid content-start gap-4 rounded-card border border-line bg-surface px-[30px] py-[34px] transition-[transform,border-color] duration-200 hover:-translate-y-1 hover:border-accent/35">
            <span class="font-display text-[15px] font-black tracking-[0.1em] text-accent [font-stretch:125%]">
              {service.num}
            </span>
            <h3 class="text-2xl">{service.title}</h3>
            <p class="text-pretty text-[16px] text-muted">{service.text}</p>
            <ul class="marker-list mt-1.5">
              {service.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
