---
import Eyebrow from "./Eyebrow.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { WHATSAPP_URL, PHONE_TEL, PHONE_DISPLAY } from "../consts";
---

<section class="bg-bg2 py-20 nav:py-[110px]" id="contacto">
  <div
    class="container-x grid items-start gap-11 nav:grid-cols-[1fr_1.1fr] nav:gap-16"
  >
    <div class="reveal from-left grid gap-[18px]">
      <Eyebrow>Contacto</Eyebrow>
      <h2 class="display text-[clamp(34px,4.6vw,54px)]">Da el primer paso</h2>
      <p class="text-pretty text-[18px] text-muted">
        Cuéntame tu caso sin compromiso. Te respondo en menos de 24 horas y
        agendamos tu primera valoración gratuita.
      </p>
      <div class="reveal-group mt-3.5 grid gap-3.5">
        <a
          class="flex items-center gap-4 rounded-soft border border-line bg-surface px-5 py-4 no-underline transition-[border-color,transform] duration-150 hover:translate-x-1 hover:border-accent/35"
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener"
        >
          <span
            class="grid size-11 flex-none place-items-center rounded-xl bg-wa/12 text-wa"
          >
            <WhatsAppIcon size={20} />
          </span>
          <div>
            <strong class="block text-[16px]">WhatsApp</strong>
            <span class="text-[14px] text-muted"
              >{PHONE_DISPLAY} — respuesta rápida</span
            >
          </div>
        </a>

        <a
          class="flex items-center gap-4 rounded-soft border border-line bg-surface px-5 py-4 no-underline transition-[border-color,transform] duration-150 hover:translate-x-1 hover:border-accent/35"
          href={`tel:${PHONE_TEL}`}
        >
          <span
            class="grid size-11 flex-none place-items-center rounded-xl bg-accent/15 text-accent"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"
              ></path>
            </svg>
          </span>
          <div>
            <strong class="block text-[16px]">Llámame</strong>
            <span class="text-[14px] text-muted">{PHONE_DISPLAY}</span>
          </div>
        </a>

        <a
          class="flex items-center gap-4 rounded-soft border border-line bg-surface px-5 py-4 no-underline transition-[border-color,transform] duration-150 hover:translate-x-1 hover:border-accent/35"
          href="https://www.instagram.com/bebalancedtraining/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span
            class="grid size-11 flex-none place-items-center rounded-xl bg-accent/15 text-accent"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"
              ></circle>
            </svg>
          </span>
          <div>
            <strong class="block text-[16px]">Instagram</strong>
            <span class="text-[14px] text-muted">@bebalancedtraining</span>
          </div>
        </a>
      </div>
    </div>

    <form class="form-card reveal from-right" id="contact-form" novalidate>
      <h3 class="text-[22px]">O escríbeme desde aquí</h3>
      <div class="form-row">
        <div class="field" id="f-nombre">
          <label for="nombre">Nombre</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            placeholder="Tu nombre"
            autocomplete="name"
          />
          <span class="err">Escribe tu nombre.</span>
        </div>
        <div class="field" id="f-telefono">
          <label for="telefono">Teléfono</label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            placeholder="600 000 000"
            autocomplete="tel"
          />
          <span class="err">Escribe un teléfono válido.</span>
        </div>
      </div>
      <div class="field" id="f-mensaje">
        <label for="mensaje">¿En qué puedo ayudarte?</label>
        <textarea
          id="mensaje"
          name="mensaje"
          placeholder="Cuéntame tu objetivo o tu lesión…"></textarea>
        <span class="err">Cuéntame brevemente tu caso.</span>
      </div>
      <button class="btn btn-accent" type="submit">Enviar mensaje</button>
      <div class="form-ok">
        ✓ ¡Mensaje enviado! Carmen te responderá en menos de 24 horas.
      </div>
    </form>
  </div>
</section>

<style>
  .form-card {
    display: grid;
    gap: 18px;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 36px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field label {
    font-size: 14px;
    font-weight: 700;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-soft);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 16px;
    transition: border-color 0.15s ease;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .field textarea {
    min-height: 110px;
    resize: vertical;
  }
  .field .err {
    display: none;
    font-size: 13px;
    color: oklch(0.72 0.16 25);
  }
  .field.invalid input,
  .field.invalid textarea {
    border-color: oklch(0.62 0.18 25);
  }
  .field.invalid .err {
    display: block;
  }
  .form-ok {
    display: none;
    padding: 16px 20px;
    border: 1px solid oklch(0.72 0.17 155 / 0.4);
    border-radius: var(--radius-soft);
    background: oklch(0.72 0.17 155 / 0.12);
    color: var(--color-text);
    font-size: 15px;
  }
  .form-card.sent .form-ok {
    display: block;
  }
</style>
