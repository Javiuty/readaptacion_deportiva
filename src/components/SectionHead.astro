---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<div class="reveal mb-14 grid max-w-[640px] gap-4">
  <Eyebrow>{eyebrow}</Eyebrow>
  <h2 class="display text-pretty text-[clamp(27px,5.5vw,54px)]">{title}</h2>
  {text && <p class="text-pretty text-[18px] text-muted">{text}</p>}
</div>
